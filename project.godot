[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="characters"
3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="water"
3d_physics/layer_4="items"
3d_physics/layer_5="vehicles"
3d_physics/layer_6="boundary"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.93, 1)
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=1024
